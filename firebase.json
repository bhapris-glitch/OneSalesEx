{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "backend/**",
      "README.md",
      "vercel.json"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "YOUR_CLOUD_RUN_SERVICE_ID",
          "region": "YOUR_CLOUD_RUN_REGION"
        }
      }
    ]
  }
}
