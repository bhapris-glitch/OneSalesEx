# Backend server
PORT=8080
FRONTEND_URL=https://zavoka.com

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=zavoka

# Stripe subscriptions and signed webhook verification
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_STARTER_PRICE_ID=price_replace_me
STRIPE_GROWTH_PRICE_ID=price_replace_me
STRIPE_PREMIUM_PRICE_ID=price_replace_me

# Shopify OAuth and webhook verification
SHOPIFY_API_KEY=replace_me
SHOPIFY_API_SECRET=replace_me
SHOPIFY_API_VERSION=2025-01
SHOPIFY_REDIRECT_URI=https://api.your-domain.com/api/shopify/callback
SHOPIFY_SCOPES=read_products,read_orders,read_checkouts,read_content,read_script_tags,write_script_tags

# Email delivery (Resend); needed for cart-recovery automation
RESEND_API_KEY=re_replace_me
FROM_EMAIL="zavoka AI <notification@zavoka.com>"
NOTIFICATION_EMAIL=contact@zavoka.com
NOTIFICATION_TIME_ZONE=UTC

# AI sales conversation (without a key, the assistant uses grounded rule-based replies)
OPENAI_API_KEY=sk-proj-replace_me
OPENAI_MODEL=gpt-4o-mini
OPENAI_PREMIUM_MODEL=gpt-5

# Protect admin API endpoints; use a long, unique secret in production
ADMIN_API_KEY=replace_with_a_long_random_secret
